# Copy this file to terraform.tfvars and fill in the actual values

# GCP Project ID
project_id = "openclaw-antonmishel-03460"

# GCP Region (us-west1 is closest to Vancouver)
region = "us-west1"

# VPC Network name
network_name = "vancity-lens-vpc"

# GKE Cluster name
cluster_name = "vancity-lens-gke"

# Cloud SQL database password
# Generate a secure password: openssl rand -base64 32
db_password = "your-secure-database-password"

# Anthropic API Key (for Claude integration)
anthropic_api_key = "your-anthropic-api-key"

# Cohere API Key (for embeddings)
cohere_api_key = "your-cohere-api-key"

# Optional runtime secrets managed in Secret Manager
database_url          = ""
k2_api_key            = ""
brave_search_api_key  = ""
admin_api_key         = ""

# Environment name
environment_name = "dev"

# Keep Cloud Run disabled for GKE-first rollout.
enable_cloudrun = false

# Document storage buckets (empty = auto-generate from project + environment)
document_archive_bucket_name   = ""
document_long_term_bucket_name = ""

# Storage lifecycle/retention
archive_transition_to_nearline_days = 30
archive_transition_to_coldline_days = 180
long_term_retention_days            = 365

# Observability baseline
log_retention_days   = 30
enable_uptime_checks = false
monitoring_app_host  = ""
monitoring_api_host  = ""

# Cloudflare (disabled by default until zone values are available)
enable_cloudflare = false
domain_name       = "vancitylense.com"
cloudflare_api_token = ""
cloudflare_zone_id   = ""

# DNS targets for Cloudflare-managed hostnames
# Use LB hostnames/IPs once ingress is provisioned.
cloudflare_app_origin     = ""
cloudflare_api_origin     = ""
cloudflare_staging_origin = ""

# Record types for targets (A or CNAME)
cloudflare_app_record_type     = "A"
cloudflare_api_record_type     = "A"
cloudflare_staging_record_type = "A"

# Optional (off by default): manage Cloudflare zone settings via Terraform
cloudflare_enable_zone_settings = false
