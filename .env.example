# ── Database ──────────────────────────────────────────────
# Local dev uses password auth; GKE uses Cloud SQL Auth Proxy (IAM auth, no password).
DATABASE_URL=postgresql://vancity:vancity_dev@localhost:5432/vancity_lens

# -- Authentication ----
JWT_SECRET=your-strong-random-secret-here  # Required. >= 32 chars. Generate with: openssl rand -hex 32

# ── AI / LLM Keys ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude for signal extraction + chat
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620  # Optional override (see api/intelligence/chat.py fallbacks)

# ── K2 Retrieval ─────────────────────────────────────────
# K2 is the default production backend for RAG search.
# Set RAG_BACKEND=local to use Cohere+pgvector for local dev.
RAG_BACKEND=k2                         # k2 (default) | local
K2_API_HOST=https://api-dev.knowledge2.ai
K2_API_KEY=mk_...                      # K2 API key (keep secret; do not commit real values)
K2_CORPUS_ID=corpus_...                # K2 corpus ID to query
K2_TOP_K=10
K2_TIMEOUT_SECONDS=20
K2_FALLBACK_TO_LOCAL=true              # if K2 fails, fall back to BM25-only sparse search

# ── Local Dev Only (RAG_BACKEND=local) ───────────────────
# COHERE_API_KEY=...                   # Cohere for embeddings + reranking (local dev only)

# ── Open-Web Search (Discovery) ────────────────────────────────
BRAVE_SEARCH_API_KEY=...              # Optional: enables discover.type=web_search in pipeline/sources.yaml

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk....       # Mapbox GL token
MAPBOX_TOKEN=pk....                   # Backend geocoding token (can reuse public token in dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── GCP (if deploying to Cloud Run) ─────────────────────
GCP_PROJECT_ID=openclaw-antonmishel-03460
GCP_REGION=us-west1
CLOUD_SQL_INSTANCE=openclaw-antonmishel-03460:us-west1:vancity-lens-db

# ── Production CORS origins (comma-separated) ───────────
CORS_ORIGINS=https://vancity-lens.pages.dev,https://your-domain.com

# ── Rate Limiting (SEC-008 / VCL-20) ────────────────────
# General API endpoints rate limit (requests per minute)
RATE_LIMIT_GENERAL=30
# LLM-heavy endpoints (chat, extraction) rate limit (requests per minute)
RATE_LIMIT_LLM=10

# -- Scraper Scheduler ----
SCRAPER_SCHEDULER_ENABLED=true             # Enable periodic scraping (council, DPB, rezoning, news, opendata)

# -- RapidAPI (Realtor.ca scraper) ----
RAPIDAPI_KEY=your-rapidapi-key-here       # Required for /api/v1/admin/scrape-realtor
RAPIDAPI_HOST=realtor-ca-scraper-api.p.rapidapi.com
