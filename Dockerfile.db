# Custom PostgreSQL with PostGIS + pgvector
# PostGIS for geospatial queries, pgvector for AI embeddings
FROM postgis/postgis:16-3.4

# Install pgvector from the PostgreSQL APT repo (pre-built, no compilation)
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-16-pgvector && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
